<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.1.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.0.2" />
    <PackageReference Include="MSTest" Version="4.0.2" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.0.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.0.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="TYoshimura.DoubleDouble" Version="5.0.1" />
    <PackageReference Include="TYoshimura.MultiPrecision" Version="6.5.0" />
    <PackageReference Include="TYoshimura.MultiPrecision.Complex" Version="1.4.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)'=='Debug'">
    <Reference Include="DoubleDoubleComplex">
      <HintPath>..\DoubleDoubleComplex\bin\Debug\net10.0\DoubleDoubleComplex.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)'=='Release'">
    <Reference Include="DoubleDoubleComplex">
      <HintPath>..\DoubleDoubleComplex\bin\Release\net10.0\DoubleDoubleComplex.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ComplexBessel">
      <HintPath>..\..\ComplexBessel\ComplexBessel\bin\Release\net8.0\ComplexBessel.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
